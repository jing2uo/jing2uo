{
  "name": "Chat",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "initializeCommand": "",
  "containerEnv": {
    "VSCODE_AGENT_FOLDER": "/workspaces/.vscode-server",
    "CLAUDE_CONFIG_DIR": "/workspaces/.claude",
    "MISE_DATA_DIR": "/workspaces/.local/share/mise",
    "XDG_CONFIG_HOME": "/workspaces/.config",
    "XDG_CACHE_HOME": "/workspaces/.cache",
    "MAGPIE_WEB_KEY": "magpie1234567890"
  },
  "remoteEnv": {
    "PATH": "/workspaces/.local/bin:/workspaces/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "forwardPorts": [3425, 3430],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
